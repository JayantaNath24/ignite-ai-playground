# ==============================================================================
# AETHER AI PLAYGROUND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure your actual provider API credentials.
# NEVER commit your real API keys or .env.local to version control!
# ==============================================================================

# --- PROVIDER API KEYS ---
# Primary provider for fast, reasoning, budget, and vision models
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Alternative provider API keys if you switch model providers
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# (Optional) Custom OpenAI-compatible self-hosted endpoint (e.g. Ollama, vLLM, LMStudio)
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=dummy-key

# --- MODEL OVERRIDES (OPTIONAL) ---
# You can override default model IDs or providers without modifying config files:
#
# MODEL_FAST_ID=llama-3.1-8b-instant
# MODEL_FAST_PROVIDER=groq
#
# MODEL_REASONING_ID=deepseek-r1-distill-llama-70b
# MODEL_REASONING_PROVIDER=groq
#
# MODEL_BUDGET_ID=llama-3.3-70b-versatile
# MODEL_BUDGET_PROVIDER=groq
#
# MODEL_VISION_ID=llama-3.2-11b-vision-preview
# MODEL_VISION_PROVIDER=groq
